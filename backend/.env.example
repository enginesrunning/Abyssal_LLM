# Copy this file to ".env" and fill in ONE provider below.
# Leave it empty to run in mock mode (the chat endpoint still works).

# --- Option A: Groq (fast, free tier, OpenAI-compatible) ---
# LLM_API_KEY=gsk_your_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option B: Google Gemini (OpenAI-compatible endpoint) ---
# LLM_API_KEY=your_gemini_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- Option C: OpenAI ---
# LLM_API_KEY=sk-your_key_here
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini

# NOTE: model names and endpoints change over time — check each provider's
# current docs and adjust LLM_MODEL / LLM_BASE_URL accordingly.

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
